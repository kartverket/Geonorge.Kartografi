@using Geonorge.Kartografi.Models
@using Geonorge.Kartografi.Services
@using Geonorge.Kartografi.Resources
@model Geonorge.Kartografi.Models.CartographyFile
@{
    List<SldLayer> sldLayers = Model.Format == "sld" ? new SldParser().Get(Model.FileUrl()) : new List<SldLayer>();
    var legendRenderer = new SldLegendRenderer();
}

@functions {

    string Tooltip(SldRule rule)
    {
        var lines = new List<string> { rule.Label };

        if (!string.IsNullOrEmpty(rule.Abstract))
            lines.Add(rule.Abstract);

        if (rule.Filter != null)
            lines.Add(UI.SldFilter + ": " + rule.Filter);
        else if (rule.IsElseFilter)
            lines.Add(UI.SldFilter + ": " + UI.SldElseFilter);

        if (rule.MinScaleDenominator.HasValue || rule.MaxScaleDenominator.HasValue)
        {
            string min = rule.MinScaleDenominator.HasValue ? "1:" + rule.MinScaleDenominator.Value.ToString("#,0") : "";
            string max = rule.MaxScaleDenominator.HasValue ? "1:" + rule.MaxScaleDenominator.Value.ToString("#,0") : "";
            lines.Add(UI.SldScale + ": " + min + " – " + max);
        }

        return string.Join("\n", lines.Where(l => !string.IsNullOrEmpty(l)));
    }

}

@if (sldLayers.Count > 0)
{
    <article class="legend-list">
        <h3>@UI.ExplanationOfSymbols</h3>
        <span class="separator-small margin-bottom-10"></span>

        @foreach (var sldLayer in sldLayers)
        {
            if (sldLayers.Count > 1)
            {
                <h4>@sldLayer.Name</h4>
            }
            <div class="row">
                @foreach (var rule in sldLayer.Rules)
                {
                    <div class="legend-list-item col-sm-4 col-md-3" title="@Tooltip(rule)">
                        @Html.Raw(legendRenderer.Render(rule))
                        <div class="sld-name">
                            <span>
                                @rule.Label
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </article>
}
